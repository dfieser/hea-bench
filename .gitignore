# Every source under data/raw is openly licensed and mirrored directly
# (see data/raw/README.md).

# The consolidated benchmark corpus is DERIVED from the sources above and
# is not committed. It is rebuilt locally and deterministically by
# `python -m hea_bench.benchmark.consolidate`; the split digests pinned
# in tests/test_benchmark_corpus.py are what guarantee a rebuild
# reproduces the exact corpus every published number was computed on.
data/consolidated/

# Built docs
docs/_build/
site/

# Large LLM-DB provenance dump (phase-prediction research; re-downloadable via DOI 10.17632/j75v9bbbjz)
data/raw/chizhevskiy2026/database_of_raw_responses.csv

# The app's in-browser engine (Pyodide runtime, wheels, package zip) is
# assembled at deploy time by tools/build_web_engine.py, never committed.
web/engine/
